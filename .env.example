# ── Cloud Run service config (set as Cloud Run env vars / secrets) ────────────

# Shared secret Jenkins sends in the X-Approval-Secret header on /notify.
APPROVAL_SHARED_SECRET=change-me-long-random

# Chat space to post approval cards into. Get it from the space URL or the
# spaces.list API. Format: spaces/AAAAxxxxxxx
CHAT_SPACE=spaces/AAAAxxxxxxx

# Project NUMBER (not ID) configured as the Chat app's audience in the Chat API
# "Connection settings". Used to verify inbound Chat requests.
CHAT_AUDIENCE=123456789012

# Jenkins API access — a DEDICATED bot user that is a member of the approver role.
JENKINS_URL=https://jenkins.cred2tech.com
JENKINS_BOT_USER=chat-approver-bot
JENKINS_BOT_TOKEN=change-me-jenkins-api-token

# Authorization — the Google Group that gates approval (same group used for the
# Jenkins 'approver' SAML role). Membership is the single source of truth.
APPROVERS_GROUP=approvers@cred2tech.com
AUTHZ_VIA_GROUP=true
# Admin user the service account impersonates (domain-wide delegation) to read
# group membership via the Admin SDK Directory API.
DIRECTORY_IMPERSONATE_USER=it-admin@cred2tech.com
